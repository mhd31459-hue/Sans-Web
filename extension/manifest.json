{
  "manifest_version": 3,
  "name": "Sans \u2014 community content filters",
  "version": "0.5.0",
  "description": "Mutes, skips, or covers scenes on Prime Video, Disney+ and Netflix using community-made timestamp maps. Never copies or captures the video.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sans",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "report-missed": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Report something Sans missed, or rate what it just filtered"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ivwmlkkcimsxcllsilld.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.disneyplus.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.disneyplus.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mhd31459-hue.github.io/Sans-Web/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "intercept.js",
        "src/*.js",
        "src/adapters/*.js"
      ],
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.disneyplus.com/*",
        "https://www.netflix.com/*"
      ]
    },
    {
      "resources": [
        "src/*.js"
      ],
      "matches": [
        "https://mhd31459-hue.github.io/*"
      ]
    }
  ]
}
